FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install --production
COPY . .

ARG NEO4J_URI
ARG NEO4J_USERNAME
ARG NEO4J_PASSWORD
ARG JWT_SECRET

ENV NEO4J_URI=$NEO4J_URI
ENV NEO4J_USER=$NEO4J_USERNAME
ENV NEO4J_USERNAME=$NEO4J_USERNAME
ENV NEO4J_PASSWORD=$NEO4J_PASSWORD
ENV NEO4J_DATABASE=neo4j
ENV JWT_SECRET=$JWT_SECRET
ENV PORT=5000

EXPOSE 5000
CMD ["node", "server.js"]
